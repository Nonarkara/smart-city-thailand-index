# Cloudflare Pages.
# Static files are served first. These rules only run when no file matches,
# and the API rules MUST stay above the SPA catch-all. Otherwise /api/* is
# rewritten to index.html with status 200 and clients download the shell.
#
# The read API itself is generated into dist/api-static by
# scripts/generate-api-artifacts.mjs. /api/cities (with query filters) is
# served by functions/api/cities.ts, which reads that same file.

/api/cities/:cityId/export.csv   /api-static/exports/cities/:cityId.csv   200
/api/exports/cities-summary.csv  /api-static/exports/cities-summary.csv   200
/api/exports/city-facts.csv      /api-static/exports/city-facts.csv       200
/api/cities/:cityId              /api-static/cities/:cityId.json          200
/api/cities                      /api-static/cities.json                  200
/api/*                           /api-static/not-found.json               404
/api                            /api-static/not-found.json               404

# The cited research snapshot. The dossier links to it as a JSON download,
# and a client that receives the SPA shell instead of JSON will try to parse
# index.html. Same hazard as /api/* — it must never fall through.
# Research failures are handled by functions/research/[[path]].ts.

# Client routes (/rankings, /compare, /city/<id> without a static OG page)
# are rewritten, not redirected, so shared links stay on their URL.
/*    /index.html    200
