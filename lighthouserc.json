{
  "ci": {
    "collect": {
      "numberOfRuns": 2,
      "chromePath": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
      "startServerCommand": "npm run preview -- --host 127.0.0.1 --port 4173",
      "startServerReadyPattern": "http://127.0.0.1:4173",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/rankings",
        "http://127.0.0.1:4173/city/phuket"
      ],
      "settings": {
        "preset": "desktop",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "throttlingMethod": "simulate",
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "unused-javascript": [
          "warn",
          {
            "maxNumericValue": 60000
          }
        ],
        "offscreen-images": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ],
        "modern-image-formats": [
          "warn",
          {
            "maxNumericValue": 0
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
